@page
@model IndexModel
@{
    Layout = null;
    List<string> slideshowImages = Model.GetImages("overall");
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
    content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>KONAR</title>
    <link rel="stylesheet" href="/main.css" />
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO"
    crossorigin="anonymous" />
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"
    integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
    crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.3/dist/umd/popper.min.js"
    integrity="sha384-ZMP7rVo3mIykV+2+9J3UJ46jBk0WLaUAdn689aCwoqbBJiSnjAK/l8WvCWPIPm49"
    crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"
    integrity="sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy"
    crossorigin="anonymous"></script>
</head>
<body>
    <nav class="navbar navbar-dark fixed-top" style="top: 5vh">
        <div class="container-fluid" style="height: 5vh">
            <a class="navbar-brand" href="#">
                <img src="/img/KONAR LOGO-cropped.svg"
                alt="Konar logo"
                class="img-responsive brand"
                style="width: 15vh" />
            </a>
            <button class="navbar-toggler custom-toggler"
            type="button"
            data-toggle="collapse"
            data-target="#navbarContent"
            aria-controls="navbarContent"
            aria-expanded="false"
            aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="#home"><i class="bi bi-house"></i> Strona główna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#aboutUs"><i class="bi bi-people"></i> O nas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#projects"><i class="bi bi-folder"></i> Projekty</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#offer"><i class="bi bi-collection"></i> Oferta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact"><i class="bi bi-telephone"></i> Kontakt</a>
                        </li>
                    </ul>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle"
                        type="button"
                        id="languageDropdown"
                        data-toggle="dropdown"
                        aria-haspopup="true"
                        aria-expanded="false">
                            PL
                        </button>
                        <div class="dropdown-menu dropdown-menu-right"
                        aria-labelledby="languageDropdown">
                            <a class="dropdown-item" href="#">PL</a>
                            <a class="dropdown-item" href="#">ENG</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- main content -->
    <div class="container-fluid d-flex flex-column vh-100"
    style="padding-top: 11vh">
        <div class="check">
            DOWIEDZ SIĘ WIĘCEJ
            <i class="bi bi-chevron-double-down"></i>
        </div>
        <div class="row flex-grow-1 justify-content-center"
        style="overflow-y: auto">
            <div class="col-12 col-md-10 col-lg-8 p-0">
                <div class="home">
                    <div class="row">
                        <div class="col-12">
                            <div class="wall-photo-container position-relative"
                            style="height: 90vh">
                                <img class="wall-photo"
                                src="/img/20241005_132136.jpg"
                                alt="Wall Photo"
                                style="width: 100%; height: 100%; object-fit: cover" />
                                <div class="logo-container">
                                    <img class="logo m-4"
                                    src="/img/KONAR LOGO-cropped.svg"
                                    alt="Logo"
                                    style="width: 50vh" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="content pt-5">
                                <div class="row flex-column">
                                    <div class="row">
                                        <div class="col-12">
                                            <h3 style="font-weight: 900">OFERTA NASZEJ FIRMY:</h3>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 mt-2">
                                            @Html.Raw(Model.Data.Description)
                                        </div>
                                    </div>
                                    <div class="row offer align-items-center">
                                        <div class="col-6 mt-3">
                                            <p style="font-weight: 600">Pozostała oferta</p>
                                            <ul>
                                                @foreach (string line in Model.Data.OfferList)
                                                {
                                                    <li>@line</li>
                                                }
                                            </ul>
                                            <p style="font-weight: 600">
                                                W ramach działalności Pracowni Projektowej KONAR
                                                oferujemy Państwu wykonanie:
                                            </p>
                                            <ul>
                                                @foreach (string line in Model.Data.ProjectsList)
                                                {
                                                    <li>@line</li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="col-6 offer-slides">
                                            <div id="carouselExampleSlidesOnly"
                                            class="carousel slide"
                                            data-ride="carousel">
                                                <div class="carousel-inner">
                                                    @for (int i = 0; i < slideshowImages.Count; i++)
                                                    {
                                                        <div class="carousel-item @(i==0?"active":"")">
                                                            <img class="d-block w-100"
                                                                 src="@slideshowImages[i]" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row flex-column p-5">
                                    <h3 style="font-weight: 900">ATUTY NASZEJ PRACOWNI:</h3>                                    
                                    <div class="container-fluid mt-5">
                                        <div class="row assets">
                                            @foreach (var tile in Model.Tiles)
                                            {
                                                <div class="col-6 col-xl-4 d-flex mb-3">
                                                    <div class="asset d-flex flex-column justify-content-center align-items-center h-100"
                                                         data-toggle="modal"
                                                         data-target="#@tile.Key-Modal">
                                                        <h5>@tile.Value.Title</h5>
                                                    </div>
                                                </div>

                                                <div class="modal fade"
                                                     id="@tile.Key-Modal"
                                                     tabindex="-1"
                                                     role="dialog">
                                                    <div class="modal-dialog modal-dialog-centered"
                                                         role="document">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title"
                                                                    id="experienceModalCenterTitle">
                                                                    @tile.Value.Title
                                                                </h5>
                                                                <button type="button"
                                                                        class="close"
                                                                        data-dismiss="modal"
                                                                        aria-label="Close">
                                                                    <span aria-hidden="true">&times;</span>
                                                                </button>
                                                            </div>
                                                            <div class="modal-body">
                                                                @Html.Raw(tile.Value.Description)
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <h3 style="font-weight: 900">KONTAKT:</h3>
                                <div class="row contact">
                                    <div class="col-4">
                                        Siedziba Pracowni Projektowej KONAR:<img src="/img/budynek.jpg"
                                                                                 class="img-fluid mb-4" />
                                    </div>
                                    <div class="col-8">
                                        <div class="row align-items-start mt-4">
                                            <div class="col-8">
                                                <h3>
                                                    <i class="bi bi-person-circle"></i> mgr inż. Jacek
                                                    Kruszyński
                                                </h3>
                                                <p><i class="bi bi-telephone"></i> 509 307 112</p>
                                                <p>
                                                    <i class="bi bi-envelope"></i><a href="mailto:jacek.kruszynski@konar.eu"
                                                                                     class="mailto-p"
                                                                                     style="color: #236084">
                                                        jacek.kruszynski@konar.eu
                                                    </a>
                                                </p>
                                            </div>
                                            <div class="col-2">
                                                <img src="/img/JACEK QR.png" class="img-fluid" />
                                            </div>
                                        </div>
                                        <div class="row mt-2 align-items-start">
                                            <div class="col-8">
                                                <h4>
                                                    <i class="bi bi-person-circle"></i> mgr inż.
                                                    Przemysław Napiórkowski
                                                </h4>
                                                <p><i class="bi bi-telephone"></i> 509 307 112</p>
                                                <p>
                                                    <i class="bi bi-envelope"></i><a href="mailto:przemek.napiorkowski@konar.eu"
                                                                                     class="mailto-p"
                                                                                     style="color: #236084">
                                                        przemek.napiorkowski@konar.eu
                                                    </a>
                                                </p>
                                            </div>
                                            <div class="col-2">
                                                <img src="/img/JACEK QR.png" class="img-fluid" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row adress align-items-center">
                                    <div class="col-6 text-center">
                                        <p style="font-size: 3rem">
                                            <i class="bi bi-pin-map"></i> ul. Łowców 1 <br />
                                            80-175 Gdańsk
                                        </p>
                                        <p><i class="bi bi-telephone"></i> (58) 732-71-51</p>
                                        <p>
                                            <i class="bi bi-printer"></i> (58) 732-71-53 by mail
                                        </p>
                                        <p>
                                            <i class="bi bi-envelope"></i><a href="mailto:info@example.com"
                                                                             class="mailto"
                                                                             style="color: #236084">
                                                Wyślij email
                                            </a>
                                        </p>
                                    </div>
                                    <div class="col-6">
                                        <div id="map"></div>
                                        <div class="map-container">
                                            <button class="map-button" onclick="openGoogleMaps()">
                                                Wyznacz trasę
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-5">
                                    <div class="col-8 description">
                                        <p>
                                            Ofertę współpracy kierujemy zarówno do indywidualnych
                                            inwestorów jak i do biur architektonicznych,
                                            konstrukcyjnych, firm wykonawczych. Siedziba firmy
                                            znajduje się w Gdańsku.
                                        </p>
                                        <p>
                                            Zapraszamy Państwa do pobrania folderu
                                            reklamowo-informacyjnego prezentującego działalność
                                            naszej pracowni
                                        </p>
                                        <ul class="description-links">
                                            <li>
                                                <img src="img/poland.png"
                                                     width="25px"
                                                     height="25px" /><a href="https://konar.eu/UserFiles/File/PLIKI/Pracownia%20Projektowa%20KONAR_folder_2021%2001%2006.pdf"
                                                                        target="_blank">
                                                    Pracownia Projektowa KONAR folder www.pdf
                                                </a>
                                            </li>
                                            <li>
                                                <img src="img/united-kingdom.png"
                                                     width="25px"
                                                     height="25px" /><a href="https://konar.eu/UserFiles/File/PLIKI/Pracownia%20Projektowa%20KONAR_folder_www_en.pdf"
                                                                        target="_blank">
                                                    Pracownia Projektowa KONAR folder www_en.pdf
                                                </a>
                                            </li>
                                            <li>
                                                <img src="img/germany.png"
                                                     width="25px"
                                                     height="25px" /><a href="https://konar.eu/UserFiles/File/PLIKI/Pracownia%20Projektowa%20KONAR_folder_www_de.pdf"
                                                                        target="_blank">
                                                    Pracownia Projektowa KONAR folder www_de.pdf
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="col-4">
                                        <h3>Skontaktuj się z nami:</h3>
                                        <form action="/send-message" method="POST">
                                            <div class="mb-3">
                                                <input type="text"
                                                       class="form-control"
                                                       id="name"
                                                       name="name"
                                                       placeholder="Twoje imię"
                                                       required />
                                            </div>
                                            <div class="mb-3">
                                                <input type="tel"
                                                       class="form-control"
                                                       id="phone"
                                                       name="phone"
                                                       placeholder="Twój numer telefonu"
                                                       required />
                                            </div>
                                            <div class="mb-3">
                                                <input type="email"
                                                       class="form-control"
                                                       id="email"
                                                       name="email"
                                                       placeholder="Twój adres e-mail"
                                                       required />
                                            </div>
                                            <div class="mb-3">
                                                <textarea class="form-control"
                                                          id="message"
                                                          name="message"
                                                          rows="4"
                                                          placeholder="Wpisz swoją wiadomość"
                                                          required></textarea>
                                            </div>
                                            <button type="submit" class="btn w-100">Wyślij</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    const lat = 54.34167704646599;
    const lng = 18.5609585174252;

    const map = L.map("map").setView([lat, lng], 11);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    L.marker([lat, lng])
      .addTo(map)
      .bindPopup("Tutaj znajduje się siedziba!")
      .openPopup();

    function openGoogleMaps() {
      window.open(
        `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`,
        "_blank"
      );
    }
</script>
