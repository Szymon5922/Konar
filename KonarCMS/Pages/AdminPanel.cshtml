@page
@model KonarCMS.Pages.AdminPanelModel
@{ }
<!DOCTYPE html>
<html>
<head>
    <title>Panel administratora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .drop-zone {
            border: 2px dashed #ccc;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            margin-bottom: 10px;
        }

            .drop-zone.dragover {
                background-color: #f0f0f0;
            }

        .thumbnail {
            width: 100px;
            height: 100px;
            object-fit: cover;
            margin: 5px;
        }

        .delete-image {
            background-color: red;
            color: white;
            border: none;
            padding: 5px;
            font-size: 1.2em;
            cursor: pointer;
            top: 0;
            right: 0;
            transform: translate(25%, -25%);
        }

            .delete-image:hover {
                background-color: darkred;
            }

        .modal-content {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h1>Panel administratora</h1>

        <!-- tiles -->
        <ul class="nav nav-tabs" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overall" type="button">Overall</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#experience" type="button">Experience</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#commitment" type="button">Commitment</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#clients" type="button">Clients</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#workplaces" type="button">Workplaces</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#constructions" type="button">Constructions</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#expertise" type="button">Expertise</button>
            </li>
        </ul>

        <!-- tiles content -->
        <div class="tab-content mt-3">
            <div class="tab-pane fade show active" id="overall">
                <form method="post" asp-page-handler="SaveOverall">
                    <h2>Ogólne</h2>
                    <textarea asp-for="OveralData.Title" class="form-control mb-2" placeholder="Tutaj umieść tytuł..."></textarea>
                    <textarea class="editor form-control mb-2" asp-for="OveralData.Description" placeholder="Tutaj umieść tekst..."></textarea>
                    <div id="offer-list">
                        @for (int i = 0; i < Model.OveralData.OfferList.Count; i++)
                        {
                            <div class="offer-item d-flex gap-2 mb-2">
                                <input type="text" class="form-control offer-input"
                                       name="OveralData.OfferList[@i]"
                                       value="@Model.OveralData.OfferList[i]" />
                                <button type="button" class="btn btn-danger" onclick="removeOffer(this)">Usuń</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-secondary mt-2" onclick="addOffer()">Dodaj ofertę</button>
                    <div id="projects-list">
                        @for (int i = 0; i < Model.OveralData.ProjectsList.Count; i++)
                        {
                            <div class="project-item d-flex gap-2 mb-2">
                                <input type="text" class="form-control project-input"
                                       name="OveralData.ProjectsList[@i]"
                                       value="@Model.OveralData.ProjectsList[i]" />
                                <button type="button" class="btn btn-danger" onclick="removeProject(this)">Usuń</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-secondary mt-2" onclick="addProject()">Dodaj projekt</button>
                    <div></div>
                    <button type="submit" class="btn btn-primary mt-2 mb-5">Zapisz</button>
                </form>

                <h3>Aktualne zdjęcia</h3>
                <div class="d-flex flex-wrap">
                    @foreach (var image in Model.GetImages("overall"))
                    {
                        <div class="position-relative">
                            <img src="@image" class="thumbnail" />

                            <!-- Formularz usuwania zdjęcia -->
                            <button class="btn btn-danger btn-sm position-absolute top-0 end-0 p-1"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-image="@image" data-target="overall"
                                    style="border:none; padding: 5px; font-size: 1.5em;">
                                <i class="bi bi-trash3-fill" style="color: white;"></i>
                            </button>
                        </div>
                    }
                </div>

                <form method="post" asp-page-handler="UploadImages" enctype="multipart/form-data" class="mt-3" id="uploadForm-overall">
                    <h2>Dodaj zdjęcia</h2>
                    <div class="drop-zone" id="dropZone-overall">Przeciągnij i upuść pliki tutaj lub kliknij, aby wybrać</div>
                    <input type="file" name="uploadedFiles" accept="image/*" multiple class="form-control mb-2 d-none" id="fileInput-overall" />
                    <input type="hidden" name="targetName" value="overall" />
                    <ul id="fileList-overall" class="list-group mb-2"></ul>
                    <button type="submit" class="btn btn-secondary mb-5">Prześlij zdjęcia</button>
                </form>
            </div>

            @foreach (var tile in Model.Tiles)
            {
                <div class="tab-pane fade)" id="@tile.Key">
                    <form method="post" asp-page-handler="SaveTile">
                        <h2>@tile.Key</h2>
                        <input type="hidden" asp-for="Tiles[@tile.Key]" />
                        <textarea asp-for="Tiles[@tile.Key].Title" class="form-control mb-2" placeholder="Tutaj umieść tytuł..."></textarea>
                        <textarea asp-for="Tiles[@tile.Key].Description" class="editor form-control mb-2" placeholder="Tutaj umieść tekst..."></textarea>
                        <button type="submit" class="btn btn-primary @(new string[]{"workplaces","constructions"}.Contains(tile.Key) ? "" : "mb-5")">
                            Zapisz
                        </button>
                    </form>

                    @if (tile.Key == "workplaces" || tile.Key == "constructions")
                    {
                        <h3>Aktualne zdjęcia</h3>
                        <div class="d-flex flex-wrap">
                            @foreach (var image in Model.GetImages(tile.Key))
                            {
                                <div class="position-relative">
                                    <img src="@image" class="thumbnail" />

                                    <!-- Formularz usuwania zdjęcia -->
                                    <button class="btn btn-danger btn-sm position-absolute top-0 end-0 p-1"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-image="@image" data-target="@tile.Key"
                                            style="border:none; padding: 5px; font-size: 1.5em;">
                                        <i class="bi bi-trash3-fill" style="color: white;"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        <form method="post" asp-page-handler="UploadImages" enctype="multipart/form-data" class="mt-3" id="uploadForm-@tile.Key">
                            <h2>Dodaj zdjęcia</h2>
                            <div class="drop-zone" id="dropZone-@tile.Key">Przeciągnij i upuść pliki tutaj lub kliknij, aby wybrać</div>
                            <input type="file" name="uploadedFiles" accept="image/*" multiple class="form-control mb-2 d-none" id="fileInput-@tile.Key" />
                            <input type="hidden" name="targetName" value="@tile.Key" />
                            <ul id="fileList-@tile.Key" class="list-group mb-2"></ul>
                            <button type="submit" class="btn btn-secondary mb-5">Prześlij zdjęcia</button>
                        </form>
                    }
                </div>
            }
        </div>
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Potwierdzenie usunięcia zdjęcia</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Czy na pewno chcesz usunąć to zdjęcie?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                        <form method="post" asp-page-handler="DeleteImage" id="deleteForm">
                            <input type="hidden" id="imageToDelete" name="imageToDelete" />
                            <input type="hidden" id="target" name="target" />
                            <button type="submit" class="btn btn-danger">Usuń</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/38.1.0/classic/ckeditor.js"></script>
    <script>
        document.querySelectorAll('.editor').forEach((textarea) => {
            ClassicEditor.create(textarea).catch(error => console.error('Editor error', error));
        });

        document.querySelectorAll("[id^='dropZone-']").forEach(dropZone => {
            const tileKey = dropZone.id.split('-')[1];
            const fileInput = document.getElementById(`fileInput-${tileKey}`);
            const fileList = document.getElementById(`fileList-${tileKey}`);

            dropZone.addEventListener("click", () => fileInput.click());
            dropZone.addEventListener("dragover", (e) => {
                e.preventDefault();
                dropZone.classList.add("dragover");
            });
            dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragover"));
            dropZone.addEventListener("drop", (e) => {
                e.preventDefault();
                dropZone.classList.remove("dragover");
                fileInput.files = e.dataTransfer.files;
                updateFileList(fileList, fileInput.files);
            });

            fileInput.addEventListener("change", () => updateFileList(fileList, fileInput.files));
        });

        function updateFileList(fileList, files) {
            fileList.innerHTML = "";
            Array.from(files).forEach(file => {
                const listItem = document.createElement("li");
                listItem.classList.add("list-group-item");
                listItem.textContent = file.name;
                fileList.appendChild(listItem);
            });
        }

    </script>
    <script>
        // Obsługuje dynamiczne ustawianie danych w formularzu usuwania
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Przycisk, który otworzył modal
            var image = button.getAttribute('data-image'); // Ścieżka obrazu
            var target = button.getAttribute('data-target'); // Klucz celu

            // Ustawienie wartości w formularzu
            document.getElementById('imageToDelete').value = image;
            document.getElementById('target').value = target;
        });
    </script>
    <script>
        function addOffer() {
            let offerList = document.getElementById('offer-list');
            let index = offerList.children.length; // Pobieramy aktualną liczbę elementów

            let div = document.createElement('div');
            div.classList.add('offer-item', 'd-flex', 'gap-2', 'mb-2');
            div.innerHTML = `
                <input type="text" class="form-control offer-input"
                       name="OveralData.OfferList[${index}]"
                       placeholder="Wpisz ofertę..." />
                <button type="button" class="btn btn-danger" onclick="removeOffer(this)">Usuń</button>
            `;
            offerList.appendChild(div);
        }

        function removeOffer(button) {
            button.parentElement.remove();

            // Aktualizacja indeksów w inputach
            let inputs = document.querySelectorAll('.offer-input');
            inputs.forEach((input, i) => {
                input.name = `OveralData.OfferList[${i}]`;
            });
        }

        function addProject() {
            let projectsList = document.getElementById('projects-list');
            let index = projectsList.children.length; // Pobieramy aktualną liczbę elementów

            let div = document.createElement('div');
            div.classList.add('project-item', 'd-flex', 'gap-2', 'mb-2');
            div.innerHTML = `
                <input type="text" class="form-control offer-input"
                       name="OveralData.ProjectsList[${index}]"
                       placeholder="Wpisz ofertę..." />
                <button type="button" class="btn btn-danger" onclick="removeProject(this)">Usuń</button>
            `;
            projectsList.appendChild(div);
        }

        function removeProject(button) {
            button.parentElement.remove();

            // Aktualizacja indeksów w inputach
            let inputs = document.querySelectorAll('.project-input');
            inputs.forEach((input, i) => {
                input.name = `OveralData.ProjectsList[${i}]`;
            });
        }
    </script>
</body>
</html>